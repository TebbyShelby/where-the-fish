  create view "dev"."silver"."stg_weather__dbt_tmp" as (
    -- Staging model for weather forecast data
-- Cleans JSON, deduplicates, translates forecast text to english

with raw as (
    select * from bronze.weather_raw
),

cleaned as (
    select
        raw.data['location']['location_id']::varchar as location_id,
        raw.data['location']['location_name']::varchar as location_name,
        raw.data['date']::date as forecast_date,
        raw.data['min_temp']::int as min_temp_celsius,
        raw.data['max_temp']::int as max_temp_celsius,
        raw.data['morning_forecast']::varchar as morning_forecast,
        raw.data['afternoon_forecast']::varchar as afternoon_forecast,
        raw.data['night_forecast']::varchar as night_forecast,
        raw.data['summary_forecast']::varchar as summary_forecast,
        raw.data['summary_when']::varchar as summary_when,
        raw._ingested_at as ingested_at
    from raw
),

-- Deduplicate: some locations have 2 rows per date (full + summary)
deduped as (
    select distinct on (location_id, forecast_date) *
    from cleaned
    where location_id is not null
      and forecast_date is not null
    order by location_id, forecast_date, ingested_at desc
)

select * from deduped
order by location_name, forecast_date
  );

